{
  "name": "Denoise IMU Gyro Dev Container",
  "image": "rocm/pytorch:rocm7.1.1_ubuntu24.04_py3.12_pytorch_release_2.9.1",
  "runArgs": ["--cap-add=SYS_PTRACE","--security-opt" ,"seccomp=unconfined","--device=/dev/kfd", "--device=/dev/dri", "--group-add=video","--ipc=host","--shm-size=8G"],
  "postCreateCommand": "pip install --no-cache-dir numpy matplotlib pyyaml scipy requests tqdm tensorboard termcolor",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached"
}
//docker run -it   --cap-add=SYS_PTRACE   --security-opt seccomp=unconfined   --device=/dev/kfd   --device=/dev/dri   --group-add video   --ipc=host   --shm-size 8G   rocm/pytorch:rocm7.1.1_ubuntu24.04_py3.12_pytorch_release_2.9.1